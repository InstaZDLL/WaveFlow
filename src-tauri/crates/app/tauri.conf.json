{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaveFlow",
  "version": "1.9.1",
  "identifier": "app.waveflow",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "WaveFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true,
        "visible": false
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "WaveFlow",
        "width": 360,
        "height": 240,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "backgroundColor": "#121212"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "connect-src": ["ipc:", "http://ipc.localhost"],
        "img-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "data:",
          "blob:",
          "https:",
          "http:"
        ],
        "media-src": [
          "'self'",
          "asset:",
          "http://asset.localhost",
          "https:",
          "http:"
        ],
        "font-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/waveflow/profiles/**",
            "$APPLOCALDATA/waveflow/profiles/**",
            "$APPDATA/waveflow/metadata_artwork/**",
            "$APPLOCALDATA/waveflow/metadata_artwork/**",
            "$APPDATA/waveflow/motion_cache/**",
            "$APPLOCALDATA/waveflow/motion_cache/**",
            "$APPDATA/waveflow/canvas_cache/**",
            "$APPLOCALDATA/waveflow/canvas_cache/**"
          ],
          "deny": [
            "$APPDATA/waveflow/profiles/**/data.db*",
            "$APPLOCALDATA/waveflow/profiles/**/data.db*"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "InstaZDLL",
    "copyright": "Copyright © 2026 InstaZDLL. Licensed under GPL-3.0-only.",
    "category": "Music",
    "shortDescription": "Local-first music player with Hi-Res audio and word-synced lyrics.",
    "longDescription": "WaveFlow is a local-first music player for Windows, macOS and Linux. It scans your music folders, organizes everything by album, artist and genre, and plays it through its own real-time audio engine. No account, no subscription, no streaming service: your music stays on your machine. Hi-Res audio, bit-perfect when you ask for it, with exclusive output, native DSD, 5.1 and 7.1, gapless playback and AutoMix crossfades that land on the beat. Lyrics are synced word by word, with romanization and translations, in the app, the mini-player or a floating desktop window. Smart playlists, Daily Mix and Release Radar build sessions from your library, MusicBrainz fills its gaps, and a tag workshop edits it with an undo. Six skins and fourteen themes, podcasts, WebDAV and SMB shares, Last.fm and ListenBrainz scrobbling, DLNA and MPD servers, your own WaveFlow Server, and sandboxed plugins for more lyrics sources, animated covers and web radio.",
    "homepage": "https://waveflow.app",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../resources/plugins/web-radio/plugin.wasm": "plugins/web-radio/plugin.wasm",
      "../../resources/plugins/web-radio/manifest.toml": "plugins/web-radio/manifest.toml"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "waveflow.entitlements"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/open-with.nsh"
      },
      "wix": {
        "fragmentPaths": ["windows/open-with.wxs"],
        "componentRefs": ["WaveFlowOpenWith"]
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "desktopTemplate": "linux/waveflow.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/waveflow.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/InstaZDLL/WaveFlow/releases/latest/download/latest.json",
        "https://download.waveflow.app/stable/latest.json"
      ],
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3QkUyODExMTcwQjVFM0MKUldROFhnc1hFU2krWitudmcvdHNIamo5RHVjV0tzaWJsS2ZVa3g5QUdKa3B0NXJ1dzF1QU1oNGgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
