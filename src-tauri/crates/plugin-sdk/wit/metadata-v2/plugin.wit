// WaveFlow metadata enricher world — v2.
//
// Same job as v1 (artist bios, album details, artwork, lyrics) with one
// change: `lyrics` can finally carry what a word-level provider actually
// has. v1's vocabulary was a line and an optional start time, which is
// what LRCLIB already gives for free, so a provider holding per-word
// timing had to throw it away to hand it over — and the host never even
// called the function (issue #585).
//
// WHY A NEW WORLD RATHER THAN A BUMP IN PLACE. v1's own header allowed
// itself one ABI-breaking edit on the grounds that nothing consumed it
// yet. Something does now: `apple-artwork` is published in the registry
// against `waveflow:metadata/v1`. Changing a record's shape changes its
// Component Model type, so this is a new world label, and the host's
// `worlds` catalog keys on the `/vN` label rather than the WIT semver.
//
// V1 IS DEPRECATED FROM THIS FILE'S FIRST DAY, and deliberately kept
// loadable only while its one consumer migrates. `apple-artwork` moves to
// v2; once it has, v1 goes at the next breaking release. It is not a
// compatibility promise to third parties — there are none — and without
// this paragraph it would survive for years "just in case", which is
// exactly how v1's `lyrics` came to be declared and never wired.
//
// WHY DOCUMENTS RATHER THAN LINES AND WORDS. The host does not model
// lyrics as a structure at all: it stores `content: String` plus a
// `format` tag, and the line/word split lives in TypeScript, in the
// renderer. A structured record here would mean inventing a Rust model
// that duplicates a parser that already exists elsewhere, and the raw
// document carries things that model could not yet express anyway —
// per-word timing, per-line singer, background vocals. So a plugin hands
// over the document it received and the host validates only that the
// bytes look like the format they claim: `detect_format(content)` must
// agree with `format` before anything is cached. No semantic parsing
// crosses into Rust.

package waveflow:metadata@2.0.0;

interface enricher {
  record artist-details {
    bio: option<string>,
    image-url: option<string>,
    similar: list<string>,
  }

  record album-details {
    description: option<string>,
    cover-url: option<string>,
    track-count: option<u32>,
    /// Looping video URL for the square animated cover, rendered
    /// behind the now-playing view. MUST be a directly-playable
    /// progressive file (`.mp4`) — the host renders it in a native
    /// `<video>` element with no HLS.js, so a bare HLS `.m3u8` will
    /// NOT play on all platforms (WebView2 has no native HLS). A
    /// plugin whose source is HLS resolves it to an mp4 rendition
    /// before returning. `none` = no motion artwork for this album.
    motion-cover-url: option<string>,
    /// Optional taller variant (lock-screen / expanded artwork
    /// aspect), same mp4 constraint. `none` falls back to
    /// `motion-cover-url`.
    motion-cover-tall-url: option<string>,
  }

  /// Mirrors the host's own `LyricsFormat`. The host re-sniffs the
  /// content and refuses the document if the two disagree, so this is
  /// a declaration to be checked, not a promise to be trusted.
  enum lyrics-format {
    plain,
    lrc,
    enhanced-lrc,
    ttml,
  }

  /// What an extra document is, relative to the primary one.
  ///
  /// `translation` — the same lyrics in another language.
  /// `pronunciation` — a Latin-script transliteration of the original,
  /// which is why it usually carries no language of its own.
  enum associated-kind {
    translation,
    pronunciation,
  }

  record lyrics-document {
    /// The document verbatim, as the provider served it. Do not
    /// re-serialise it into another format on the way out: TTML
    /// carries per-word timing, singer attribution and background
    /// vocals that no other format here can hold, and the host
    /// preserves whatever arrives.
    content: string,
    format: lyrics-format,
    /// BCP-47 tag. `none` when the provider does not say.
    language: option<string>,
  }

  record associated-document {
    kind: associated-kind,
    document: lyrics-document,
  }

  /// One fetch result: the lyrics, plus whatever came with them.
  ///
  /// The host caches a bundle as a unit and replaces it as a unit, so a
  /// primary document from one provider can never be left paired with
  /// another's translation. At most one associated document per
  /// (kind, language); a second one for the same slot is dropped rather
  /// than kept as a rival version.
  record lyrics-bundle {
    primary: lyrics-document,
    associated: list<associated-document>,
  }

  /// Free-form artist info lookup by name. Plugins normalise the
  /// name themselves (case, diacritics) — the host hands what the
  /// user has, verbatim.
  artist-info: func(name: string) -> result<artist-details, string>;

  /// Album lookup. Some plugins key on `(artist, title)` pairs;
  /// pass both even if your DB only uses one.
  album-info: func(artist: string, title: string) -> result<album-details, string>;

  /// Lyrics lookup. `none` = this provider has nothing for the track,
  /// which is a real answer the host may cache as a miss; `err` means
  /// the lookup could not be made at all and nothing is written.
  lyrics: func(artist: string, title: string) -> result<option<lyrics-bundle>, string>;
}

world plugin {
  import waveflow:host/http@1.0.0;
  import waveflow:host/log@1.0.0;
  import waveflow:host/storage@1.0.0;
  import waveflow:host/config@1.0.0;
  export enricher;
}
