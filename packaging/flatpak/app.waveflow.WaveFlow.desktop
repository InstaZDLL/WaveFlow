[Desktop Entry]
Type=Application
Version=1.0
Name=WaveFlow
GenericName=Music Player
GenericName[fr]=Lecteur de musique
Comment=Local-first music player with Hi-Res audio and word-synced lyrics
Comment[fr]=Lecteur de musique local, audio haute résolution et paroles synchronisées mot à mot
Exec=waveflow %U
Icon=app.waveflow.WaveFlow
Terminal=false
StartupNotify=true
StartupWMClass=waveflow
Categories=AudioVideo;Audio;Player;Music;
Keywords=music;player;audio;local;offline;library;flac;dsd;hi-res;bit-perfect;gapless;crossfade;lyrics;playlist;musicbrainz;dlna;scrobble;
Keywords[fr]=musique;lecteur;audio;local;hors ligne;bibliothèque;flac;dsd;hi-res;bit-perfect;gapless;fondu;paroles;playlist;musicbrainz;dlna;scrobble;
MimeType=audio/mpeg;audio/flac;audio/x-flac;audio/wav;audio/x-wav;audio/aiff;audio/x-aiff;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/aac;audio/x-wavpack;audio/x-ape;audio/x-dsf;audio/x-dff;
SingleMainWindow=true
